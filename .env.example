# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard > Project Settings > API Keys (or Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Browser safe, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No secret key is needed: every read and write runs as the signed-in user under RLS.
# Admins are rows in public.admins, added once in the Supabase SQL editor (see PROJECT.md).
