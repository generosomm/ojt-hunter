# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard > Project Settings > API Keys (or Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Browser safe, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used from Phase 1 on. Server only, never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# Comma separated Google emails that get admin.
# ADMIN_EMAILS=
